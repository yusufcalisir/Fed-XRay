# Fed-XRay .gitignore

# ===== AI Agent Directives & Research (Local Only) =====
AGENTS.md
research/
.agents/
.gemini/

# ===== Credentials & Sensitive Files =====
cookies.txt
*.cookie
*.cookies
*.key
*.pem
*.token
token.txt
credentials.json
.streamlit/secrets.toml

# ===== Node.js & Next.js =====
node_modules/
.next/
out/
.vercel
*.tsbuildinfo
next-env.d.ts

# Whitelist frontend/src and lib
!frontend/src/
!frontend/src/**
!frontend/src/lib/
!frontend/src/lib/**

# ===== Environment Variables =====
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/

# Keep example env
!.env.example
!frontend/.env.example

# ===== Generated Outputs & Reports =====
*.pdf
output/
reports/
generated_reports/

# ===== Python & Bytecode =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ===== Deep Learning Checkpoints & Weights =====
*.pt
*.pth
*.onnx
*.bin
*.safetensors
checkpoints/
saved_models/

# ===== Jupyter Notebooks =====
.ipynb_checkpoints/
*.ipynb

# ===== IDEs & Editors =====
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ===== Operating System Files =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===== Logs =====
*.log
logs/

# ===== Datasets & Local Data =====
data/
datasets/
*.csv

# Unignore necessary JSON and config files
!package.json
!frontend/package.json
!tsconfig.json
!frontend/tsconfig.json
!vercel.json
!frontend/vercel.json
!render.yaml
!requirements.txt

# ===== Temporary & Cache Files =====
tmp/
temp/
scratch/
*.tmp
*.bak
*.cache

# ===== Testing & Coverage =====
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
